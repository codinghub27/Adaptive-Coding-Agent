# Database - async SQLAlchemy connection string for the local Postgres (see docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://coding_agent:coding_agent@localhost:5433/coding_agent_db
DATABASE_URL_RO=postgresql://readonly_user:change-me@localhost:5432/codingagent_db  # read-only role, used only by the postgres MCP (not the app)
# Qdrant - vector store connection for knowledge retrieval
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=10

# LLM provider - chat/embedding/vision client wrapper config
LLM_PROVIDER=groq
# groq | openrouter
LLM_MODEL=
# blank = provider default
GROQ_API_KEY=
OPENROUTER_API_KEY=

# LangSmith - tracing/observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adaptive-coding-agent

# API - CORS and environment
CORS_ORIGINS=http://localhost:8501
APP_ENV=dev
